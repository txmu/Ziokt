{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ziokt Client",
  "version": "1.0.0",
  "identifier": "com.ziokt.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Ziokt 统一图形客户端",
        "width": 1240,
        "height": 820,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "android": {
      "v4Signing": true
    }
  }
}
