<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Ziokt Effort" Manufacturer="Ziokt" Version="1.0.1" UpgradeCode="81A42FAD-501D-49FA-A00C-302C585D5894" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer Ziokt Effort version is installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="ZioktEffort">
        <Component Id="EffortMain" Guid="E3F8D2BF-3D22-474F-A166-9F8207468F70">
          <File Id="EffortExe" Source="$(var.PublishDir)\ZioktEffort.exe" />
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Ziokt Effort" Target="[#EffortExe]" WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\Ziokt\Effort" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveEffortDirectory" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <CustomAction Id="RemoveEffortStartup" FileRef="EffortExe" ExeCommand="--remove-startup" Execute="immediate" Return="check" />
    <InstallExecuteSequence><Custom Action="RemoveEffortStartup" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" /></InstallExecuteSequence>
    <Feature Id="Effort" Title="Ziokt Effort" Level="1"><ComponentRef Id="EffortMain" /></Feature>
  </Package>
</Wix>
