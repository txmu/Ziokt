<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Ziokt Effort" Manufacturer="Ziokt" Version="1.0.0" UpgradeCode="81A42FAD-501D-49FA-A00C-302C585D5894" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer Ziokt Effort version is installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="ZioktEffort">
        <Component Id="EffortMain" Guid="*">
          <File Id="EffortExe" Source="$(var.PublishDir)\ZioktEffort.exe" />
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Ziokt Effort" Target="[#EffortExe]" WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\Ziokt\Effort" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          <RemoveRegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="ZioktEffort" Action="removeOnUninstall" />
          <RemoveFolder Id="RemoveEffortDirectory" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Effort" Title="Ziokt Effort" Level="1"><ComponentRef Id="EffortMain" /></Feature>
  </Package>
</Wix>
