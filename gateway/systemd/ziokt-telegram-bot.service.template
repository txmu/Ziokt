[Unit]
Description=Ziokt Telegram to MCP command bridge
After=network-online.target @@MCP_UNIT@@.service
Wants=network-online.target

[Service]
Type=simple
User=@@SERVICE_USER@@
WorkingDirectory=@@SOURCE_ROOT@@
ExecStart=@@PYTHON@@ -m ziokt mcp telegram-worker --config @@MCP_CONFIG@@
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=256M
TasksMax=32
LimitNOFILE=512
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
