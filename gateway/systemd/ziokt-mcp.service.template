[Unit]
Description=Ziokt scoped native MCP gateway
After=network-online.target ziokt-gateway.service
Wants=network-online.target
[Service]
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ -m ziokt mcp serve --config @CONFIG@
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=768M
TasksMax=128
LimitNOFILE=2048
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
