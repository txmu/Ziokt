[Unit]
Description=Ziokt production effort
After=network-online.target
Wants=network-online.target
After=ziokt-corium-p2p.service
[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/.local/share/ziokt-production
ExecStart=/usr/bin/python3 /home/admin/.local/share/ziokt-production/bin/ziokt.pyz effort-web --config /home/admin/.local/share/ziokt-production/config/effort-web.json
Environment=XDG_DATA_HOME=/home/admin/.local/share/ziokt-production/caddy-data
Environment=XDG_CONFIG_HOME=/home/admin/.local/share/ziokt-production/caddy-config
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
