# 8. MCP Gateway
mcp.ziokt.com {
	@root path /
	handle @root {
		respond "Ziokt MCP: connect https://mcp.ziokt.com/mcp using OAuth (CIMD)." 200
	}
	handle {
		reverse_proxy 127.0.0.1:8186
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

