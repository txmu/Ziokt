{
	admin off
}

# 1. Effort Web (奋斗页)
fendou.ziokt.com {
	reverse_proxy 127.0.0.1:8081
	header {
		Cache-Control "no-store"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# 2. WATChat PWA
# Standalone service hostname intentionally unconfigured.

# 3. SimManager PWA
sim.ziokt.com {
	redir / /sim/ 302
	@gateway path /api/* /app-config
	handle @gateway {
		reverse_proxy 127.0.0.1:8183
	}
	handle /sim/* {
		root * /home/admin/.local/share/ziokt-production/apps/sim-manager
		try_files {path} /sim/index.html
		file_server
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
			Cache-Control no-cache
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

