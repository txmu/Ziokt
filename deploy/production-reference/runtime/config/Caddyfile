# 10. Unified Graphical Client
app.ziokt.com {
	handle_path /downloads/* {
		root * /home/admin/.local/share/ziokt-production/downloads/gui
		file_server
		header Cache-Control no-cache
	}
	handle /api/gateway/* {
		reverse_proxy 127.0.0.1:8185
	}
	handle {
		root * /home/admin/Ziokt/gateway/gui
		try_files {path} /index.html
		file_server
		header Cache-Control no-cache
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://cor-web.ziokt.com wss://cor-web.ziokt.com https://read.ziokt.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}
}

# 11. DNS Server
dns.ziokt.com {
	@dns path /dns-query /realms/*/dns-query
	handle @dns {
		reverse_proxy 127.0.0.1:8188 {
			header_up X-Ziokt-Client-IP {remote_host}
		}
	}
	handle {
		respond "Ziokt DNS — DoH: https://dns.ziokt.com/dns-query ; private suffixes only; no public DNS recursion." 200
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control no-store
	}
}

