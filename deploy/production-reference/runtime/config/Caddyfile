}

# 5. Gateway / DApp
gateway.ziokt.com, dapp.ziokt.com {
	@zioktNative path /api/gateway/* /gateway-assets/* /stream/*
	handle @zioktNative {
		reverse_proxy 127.0.0.1:8185 {
			header_up X-Ziokt-Client-IP {remote_host}
		}
	}
	@zioktMcp path /mcp /oauth/* /.well-known/oauth-protected-resource* /.well-known/oauth-authorization-server
	handle @zioktMcp {
		reverse_proxy 127.0.0.1:8186
	}

	redir / /app/explorer 302
	reverse_proxy 127.0.0.1:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# 6. cor-web.ziokt.com
cor-web.ziokt.com {
	redir /app/explorer/cbb /app/explorer/blockchain?{query} 302
	redir /gateway-assets/gui/downloads/* https://app.ziokt.com/downloads/ 302
	redir /app/gui* https://app.ziokt.com/ 302
	redir /app/desktop* https://app.ziokt.com/ 302
	redir /app/client* https://app.ziokt.com/ 302
	redir /downloads https://app.ziokt.com/downloads/ 302
	redir /downloads/* https://app.ziokt.com{uri} 302

	handle_path /effort/* {
		reverse_proxy 127.0.0.1:8081 {
			header_up Host fendou.ziokt.com
		}
	}
	handle_path /chat/* {
		reverse_proxy 127.0.0.1:8182 {
			header_up Host {host}
		}
	}
	handle /sim/* {
		root * /home/admin/.local/share/ziokt-production/apps/sim-manager
		try_files {path} /sim/index.html
		file_server
	}
	handle /tri/* {
		root * /home/admin/.local/share/ziokt-production/apps/tri
		try_files {path} /tri/index.html
		file_server
	}
	handle_path /ufs/* {
		reverse_proxy 127.0.0.1:8184 {
			header_up Host {host}
		}
	}
	handle_path /shadow6/* {
		reverse_proxy 127.0.0.1:9467 {
			header_up Host {host}
		}
	}

	@zioktNative path /api/gateway/* /gateway-assets/* /stream/*
	handle @zioktNative {
		reverse_proxy 127.0.0.1:8185 {
			header_up X-Ziokt-Client-IP {remote_host}
		}
	}
	@zioktMcp path /mcp /oauth/* /.well-known/oauth-protected-resource* /.well-known/oauth-authorization-server
	handle @zioktMcp {
		reverse_proxy 127.0.0.1:8186
	}

	@root path / /index.html
	rewrite @root /nns/corium
	reverse_proxy 127.0.0.1:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

