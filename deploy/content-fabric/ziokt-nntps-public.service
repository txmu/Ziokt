[Unit]
Description=Ziokt NNTP over TLS with an independently scoped posting identity
After=network-online.target ziokt-content.service ziokt-https.service
Requires=ziokt-content.service

[Service]
Type=simple
User=admin
Group=admin
ExecStart=/usr/bin/socat OPENSSL-LISTEN:563,min-version=TLS1.2,bind=0.0.0.0,reuseaddr,fork,max-children=16,cert=/home/admin/.local/share/ziokt-production/caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/nntp.ziokt.com/nntp.ziokt.com.crt,key=/home/admin/.local/share/ziokt-production/caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/nntp.ziokt.com/nntp.ziokt.com.key,verify=0 TCP4:127.0.0.1:8120
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=32M
TasksMax=20
LimitNOFILE=128
UMask=0077

[Install]
WantedBy=multi-user.target
